# InsureTutor runtime configuration
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (optional) ---
# Any OpenAI-compatible endpoint. If unset, InsureTutor runs in offline/extractive
# mode: retrieved passages and citations, no synthesis.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval ---
# Weight of BM25 vs vector in the hybrid score. 0.5 = equal.
HYBRID_ALPHA=0.5
# Number of chunks retrieved before reranking.
RETRIEVE_TOP_K=12
# Number of chunks passed to the generator after reranking.
RERANK_TOP_K=5

# --- Serving ---
HOST=0.0.0.0
PORT=8000

# --- Build-time only (not needed to run the container) ---
# mineru.net token for re-parsing the PDF. Never commit a real value.
MINERU_TOKEN=
