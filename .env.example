# InsureTutor runtime configuration
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM (optional) ---
# Chat Completions endpoint supporting function calls (limited compatibility).
# Final JSON is validated locally; no provider JSON mode / Schema is required.
# If unset, InsureTutor returns original excerpts and citations, no synthesis.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Optional; leave blank if your provider does not support reasoning_effort.
# Keep thinking enabled for answer quality; override for your provider as needed.
LLM_REASONING_EFFORT=medium
# Includes reasoning tokens on thinking models; the turn timeout remains 60s.
LLM_MAX_TOKENS=32768

# --- Retrieval ---
# Retrieval currently uses CLI options / HybridRetriever constructor defaults.
# Local FP32 E5; 2 CPU threads; BM25 + NumPy, equal RRF (constant 60).
# Each channel: 12 unique units; select up to 8 direct hits; source budget: 12000 chars.
# Required notes are completed automatically and do not consume the 8 direct slots.
# Model path / index path: python -m insuretutor.retrieval --help
# No embedding API, weighted-score mixing or reranker configuration is required.

# --- Serving ---
HOST=0.0.0.0
PORT=8000

# --- Build-time only (not needed to run the container) ---
# mineru.net token for re-parsing the PDF. Never commit a real value.
MINERU_TOKEN=
